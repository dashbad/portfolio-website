---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SoundCloudPlayer from '../../components/SoundCloudPlayer.astro';
import { getPublishedMusic } from '../../lib/content';

const tracks = await getPublishedMusic();
---

<BaseLayout title="Music">
  <section class="mx-auto max-w-3xl px-5 py-12 sm:px-8 sm:py-16" aria-label="Tracks">
    <header class="mb-12">
      <h1 class="text-4xl sm:text-5xl">Music</h1>
      <p class="mt-4 text-lg leading-relaxed text-silver">
        I have been DJing for over 25 years. Below you can find my latest mixes. They are sorted in reverse chronological order. Tracklists can be found in the description for each mix if you click through to Soundcloud.
      </p>
    </header>

    <ul class="space-y-12">
      {
        tracks.map((track) => (
          <li>
            <h2 class="mb-4 text-2xl sm:text-3xl">{track.data.title}</h2>
            <SoundCloudPlayer embed={track.data.soundcloudEmbedIframe} title={track.data.title} fallbackUrl={track.data.soundcloudUrl} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
