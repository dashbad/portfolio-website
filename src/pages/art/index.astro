---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery02 from '@/components/ui/gallery-02';
import { getPublishedArt } from '../../lib/content';

const works = await getPublishedArt();
const items = works.map((work) => ({
  href: `/art/${work.id}/`,
  image: work.data.heroPoster ?? '',
  caption: work.data.title,
  sub: String(work.data.year),
}));
---

<BaseLayout title="Art">
  <Gallery02 items={items} />
</BaseLayout>
