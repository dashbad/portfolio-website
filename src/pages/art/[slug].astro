---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import SpecsTable from '../../components/SpecsTable.astro';
import Gallery from '../../components/Gallery.astro';
import { getPublishedArt } from '../../lib/content';

export async function getStaticPaths() {
  const works = await getPublishedArt();
  return works.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: works[i - 1] ?? null, next: works[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { title, year, summary, heroVideo, heroPoster, specs, gallery } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary} image={heroPoster ?? undefined}>
  <article class="mx-auto max-w-6xl px-5 pt-8 sm:px-8">
    <a href="/art" class="mono-label inline-flex items-center gap-2 text-silver transition-colors hover:text-neon">
      <span aria-hidden="true">←</span> All work
    </a>

    {
      heroVideo ? (
        <VideoPlayer src={heroVideo} poster={heroPoster ?? undefined} mode="ambient" title={`${title} — ambient loop`} aspect="21 / 9" class="mt-6" />
      ) : heroPoster ? (
        <div class="mt-6 overflow-hidden rounded-lg border border-line bg-charcoal aspect-[21/9] relative">
          <img src={heroPoster} alt={title} class="h-full w-full object-cover" />
        </div>
      ) : null
    }

    <header class="mt-10 max-w-3xl">
      <p class="mono-label text-neon">
        <span class="text-silver">{year}</span>
      </p>
      <h1 class="mt-3 text-4xl sm:text-6xl">{title}</h1>
      {summary && <p class="mt-6 whitespace-pre-line text-lg leading-relaxed text-silver">{summary}</p>}
    </header>

    <div class="mdx mt-10 max-w-3xl [&:empty]:hidden">
      <Content />
    </div>

    {
      gallery.length > 0 && (
        <section class="mt-14 border-t border-line pt-10" aria-labelledby="build-log">
          <p class="mono-label text-neon">Bench</p>
          <h2 id="build-log" class="mt-2 text-3xl">Build log</h2>
          <Gallery images={gallery} columns={3} class="mt-8" />
        </section>
      )
    }

    <section class="mt-14 border-t border-line pt-10 max-w-3xl" aria-label="Specifications">
      <SpecsTable specs={specs} />
    </section>

    <nav class="mt-20 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" aria-label="Adjacent works">
      {
        prev ? (
          <a href={`/art/${prev.id}/`} class="group rounded-lg border border-line bg-charcoal p-5 transition-colors hover:border-neon/70">
            <span class="mono-label text-silver/60">← Previous</span>
            <span class="mt-2 block text-lg text-white group-hover:text-neon">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/art/${next.id}/`} class="group rounded-lg border border-line bg-charcoal p-5 text-right transition-colors hover:border-neon/70">
            <span class="mono-label text-silver/60">Next →</span>
            <span class="mt-2 block text-lg text-white group-hover:text-neon">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
