---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import Hero07 from '@/components/ui/hero-07';
import GalleryGridBlock from '@/components/ui/gallery-grid-block-shadcnui';
import KeyValueList from '@/components/ui/key-value-list';
import { getPublishedArt } from '../../lib/content';

export async function getStaticPaths() {
  const works = await getPublishedArt();
  return works.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: works[i - 1] ?? null, next: works[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { title, year, summary, heroVideo, heroPoster, heroTile, specs, gallery } = entry.data;
const { Content } = await render(entry);

const galleryImages = gallery.map((img, i) => ({
  id: `${entry.id}-${i}`,
  url: img.src,
  alt: img.alt || title,
  caption: img.caption,
}));

const specItems = (
  [
    ['Dimensions', specs.dimensions],
    ['Controller', specs.controller],
    ['Power', specs.power],
    ['Illumination', specs.illumination],
    ['Materials', specs.materials.length ? specs.materials.join(', ') : undefined],
  ] as Array<[string, string | undefined]>
)
  .filter((row): row is [string, string] => Boolean(row[1]))
  .map(([label, value]) => ({ label, value }));
---

<BaseLayout title={title} description={summary} image={heroTile ?? heroPoster ?? undefined}>
  <article>
    <Hero07 tagline={String(year)} title={title} description={summary} landscapeImage={heroPoster ?? undefined} landscapeAlt={title}>
      {heroVideo && <VideoPlayer src={heroVideo} poster={heroPoster ?? undefined} mode="ambient" title={`${title} — ambient loop`} aspect="21 / 9" />}
    </Hero07>

    <div class="mx-auto max-w-7xl px-6 sm:px-10">
      <div class="prose-body mb-12 max-w-3xl [&:empty]:hidden">
        <Content />
      </div>

      {gallery.length > 0 && <GalleryGridBlock client:visible className="mt-2" images={galleryImages} />}

      {specItems.length > 0 && <KeyValueList items={specItems} className="mt-16 max-w-3xl" />}

      <nav class="mt-20 flex items-center justify-between gap-6 border-t border-border pt-8 text-sm" aria-label="Adjacent works">
        {
          prev ? (
            <a href={`/art/${prev.id}/`} class="text-muted-foreground transition-colors hover:text-foreground">
              ← {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={`/art/${next.id}/`} class="text-right text-muted-foreground transition-colors hover:text-foreground">
              {next.data.title} →
            </a>
          )
        }
      </nav>
    </div>
  </article>
</BaseLayout>
