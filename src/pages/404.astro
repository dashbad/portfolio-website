---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <section class="mx-auto flex max-w-7xl flex-col items-start px-6 py-32 sm:px-10">
    <h1 class="text-4xl sm:text-6xl">Page not found</h1>
    <p class="mt-6 max-w-md text-lg text-muted-foreground">Check the address or head back to the start.</p>
    <a href="/" class="mt-10 inline-flex items-center rounded-full bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-colors hover:bg-foreground/85">
      Return home
    </a>
  </section>
</BaseLayout>
