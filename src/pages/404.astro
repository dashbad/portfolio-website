---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <section class="mx-auto flex max-w-6xl flex-col items-start px-5 py-32 sm:px-8">
    <p class="mono-label text-neon">Error 404</p>
    <h1 class="mt-3 text-5xl sm:text-7xl">Signal lost.</h1>
    <p class="mt-6 max-w-md text-lg">The page you were looking for isn't wired up. Check the address or head back to the start.</p>
    <a href="/" class="btn-neon mt-10">Return home</a>
  </section>
</BaseLayout>
