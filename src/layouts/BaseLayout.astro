---
import '../styles/global.css';
import { Navbar } from '@/components/ui/mini-navbar';
import Footer16 from '@/components/ui/footer-16';
import { SOCIALS } from '@/lib/content';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path used for Open Graph previews. */
  image?: string;
  /** Remove the top padding that clears the fixed navbar (full-bleed heroes). */
  flush?: boolean;
}

const SITE_NAME = 'Dashiell Badcock';
const DEFAULT_DESCRIPTION = 'Dashiell Badcock — Portfolio';

const NAV = [
  { href: '/art', label: 'Art' },
  { href: '/music', label: 'Music' },
  { href: '/about', label: 'About' },
];

const { title, description = DEFAULT_DESCRIPTION, image, flush = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = image && Astro.site ? new URL(image, Astro.site).toString() : image;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const footerLinks = SOCIALS.map(({ label, href }) => ({ label, href }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171717" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Navbar client:load name={SITE_NAME} links={NAV} currentPath={path} />
    <main id="main" class:list={['flex-1', !flush && 'pt-20']}>
      <slot />
    </main>
    <Footer16 name={SITE_NAME} links={footerLinks} />
  </body>
</html>
