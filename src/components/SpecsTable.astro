---
/**
 * SpecsTable — minimalist technical spec sheet in mono type.
 * Accepts the `specs` object from the `art` collection schema, plus optional
 * extra rows (e.g. { "Firmware": "v2.1", "Weight": "14 kg" }).
 */
export interface Specs {
  dimensions?: string;
  controller?: string;
  power?: string;
  illumination?: string;
  materials?: string[];
}

interface Props {
  specs: Specs;
  title?: string;
  extra?: Record<string, string | undefined>;
  class?: string;
}

const { specs, title = 'Specifications', extra = {}, class: className } = Astro.props;

const rows: Array<[string, string]> = (
  [
    ['Dimensions', specs.dimensions],
    ['Controller', specs.controller],
    ['Power', specs.power],
    ['Illumination', specs.illumination],
    ...Object.entries(extra),
  ] as Array<[string, string | undefined]>
).filter((row): row is [string, string] => Boolean(row[1]));

const materials = specs.materials ?? [];
---

<aside class:list={['specs rounded-lg border border-line bg-charcoal font-mono', className]} aria-label={title}>
  <header class="flex items-center justify-between border-b border-line px-5 py-3">
    <h2 class="mono-label !font-mono text-neon">{title}</h2>
    <span class="h-1.5 w-1.5 rounded-full bg-neon shadow-neon-sm" aria-hidden="true"></span>
  </header>

  <dl class="divide-y divide-line px-5">
    {
      rows.map(([label, value]) => (
        <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-4 py-3.5 sm:grid-cols-[110px_minmax(0,1fr)]">
          <dt class="mono-label pt-0.5 text-silver/60">{label}</dt>
          <dd class="text-[13px] leading-relaxed text-white/90">{value}</dd>
        </div>
      ))
    }

    {
      materials.length > 0 && (
        <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-4 py-3.5 sm:grid-cols-[110px_minmax(0,1fr)]">
          <dt class="mono-label pt-0.5 text-silver/60">Materials</dt>
          <dd>
            <ul class="flex flex-wrap gap-1.5">
              {materials.map((m) => (
                <li class="tag">{m}</li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }

    {rows.length === 0 && materials.length === 0 && <p class="py-4 text-xs text-silver/60">No specifications recorded.</p>}
  </dl>
</aside>
