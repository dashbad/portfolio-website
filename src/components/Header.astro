---
/**
 * Header — sticky site header. Title "DASHBAD" in mono, primary nav with
 * Neon Cyan active/hover underline.
 */
const links = [
  { href: '/art', label: 'Art' },
  { href: '/music', label: 'Music' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line bg-void/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a
      href="/"
      class="group flex items-center gap-3 font-mono text-sm font-semibold tracking-[0.28em] text-white transition-colors hover:text-neon"
      aria-label="DASHBAD — home"
    >
      <span
        class="h-2 w-2 rounded-full bg-neon shadow-neon-sm transition-transform duration-300 group-hover:scale-125"
        aria-hidden="true"
      ></span>
      DASHBAD
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-6 sm:gap-9">
        {
          links.map(({ href, label }) => {
            const active = isActive(href);
            return (
              <li>
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'group relative inline-block py-2 font-mono text-[12px] uppercase tracking-[0.2em] transition-colors hover:text-neon',
                    active ? 'text-white' : 'text-silver',
                  ]}
                >
                  {label}
                  <span
                    class:list={[
                      'absolute inset-x-0 -bottom-px h-px origin-left bg-neon transition-transform duration-300 group-hover:scale-x-100',
                      active ? 'scale-x-100 shadow-neon-sm' : 'scale-x-0',
                    ]}
                    aria-hidden="true"
                  />
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
