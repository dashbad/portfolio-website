---
/**
 * SoundCloudPlayer — renders a SoundCloud embed from the raw <iframe> string
 * stored in the `music` collection.
 *
 * Safety: the string is never injected as raw HTML. The first <iframe> in the
 * pasted code is located (SoundCloud appends an attribution <div>, which is
 * ignored), its `src` must point at https://w.soundcloud.com/player/, and a
 * fresh <iframe> is rendered by Astro with a neutral player colour. Anything
 * else falls back to a plain link.
 */
interface Props {
  embed: string;
  title: string;
  /** Shown if the embed string is rejected. */
  fallbackUrl?: string;
  class?: string;
}

const { embed, title, fallbackUrl, class: className } = Astro.props;

const ALLOWED_ORIGIN = 'https://w.soundcloud.com';
const ALLOWED_PATH = '/player/';

function parseEmbed(html: string): { src: string; height: number } | null {
  const iframe = html.match(/<iframe\b[^>]*>\s*<\/iframe>/i)?.[0];
  if (!iframe) return null;

  const src = iframe.match(/\ssrc\s*=\s*["']([^"']+)["']/i)?.[1];
  if (!src) return null;

  let url: URL;
  try {
    url = new URL(src);
  } catch {
    return null;
  }
  if (url.origin !== ALLOWED_ORIGIN || !url.pathname.startsWith(ALLOWED_PATH)) return null;

  url.searchParams.set('color', '#171717');

  const rawHeight = Number(iframe.match(/\sheight\s*=\s*["']?(\d+)/i)?.[1] ?? 166);
  const height = Math.min(Math.max(rawHeight || 166, 100), 600);

  return { src: url.toString(), height };
}

const parsed = parseEmbed(embed);
---

{
  parsed ? (
    <div
      class:list={[
        'sc-player overflow-hidden rounded-xl border border-border bg-muted p-3 sm:p-4',
        className,
      ]}
    >
      <iframe
        title={`SoundCloud player: ${title}`}
        src={parsed.src}
        width="100%"
        height={parsed.height}
        allow="autoplay; encrypted-media"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        class="block w-full overflow-hidden rounded-md border-0 bg-background"
        style="border: 0; overflow: hidden;"
      />
    </div>
  ) : (
    <div class:list={['rounded-xl border border-dashed border-border bg-muted p-5 text-sm text-muted-foreground', className]}>
      <p class="text-foreground">Embed rejected — expected a single SoundCloud player &lt;iframe&gt;.</p>
      {fallbackUrl && (
        <a href={fallbackUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-foreground underline underline-offset-2">
          Listen on SoundCloud ↗
        </a>
      )}
    </div>
  )
}
