---
/**
 * Gallery — responsive masonry (CSS columns) image grid with a lightbox.
 * Used for bench / fabrication logs and 2D "3D design" render fallbacks.
 * Click any image to open the <dialog> lightbox; ← → to navigate, Esc to close.
 */
export interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
  columns?: 2 | 3 | 4;
  title?: string;
  class?: string;
}

const { images, columns = 3, title, class: className } = Astro.props;

const columnClass = {
  2: 'sm:columns-2',
  3: 'sm:columns-2 lg:columns-3',
  4: 'sm:columns-2 lg:columns-4',
}[columns];
---

<div class:list={['gallery', className]} data-gallery>
  {title && <h3 class="mono-label mb-4 text-neon">{title}</h3>}

  <div class:list={['columns-1 gap-3', columnClass]}>
    {
      images.map((img, i) => (
        <button
          type="button"
          class="group mb-3 block w-full break-inside-avoid overflow-hidden rounded-md border border-line bg-charcoal text-left transition-[border-color,box-shadow] duration-300 hover:border-neon/70 hover:shadow-neon"
          data-gallery-item
          data-index={i}
          data-src={img.src}
          data-alt={img.alt}
          data-caption={img.caption ?? ''}
          aria-label={`Open image ${i + 1} of ${images.length}: ${img.alt}`}
        >
          <span class="media-frame relative block overflow-hidden">
            <span class="media-fallback" aria-hidden="true">
              <span class="mono-label">Image offline</span>
            </span>
            <img
              src={img.src}
              alt={img.alt}
              loading="lazy"
              decoding="async"
              class="relative z-10 block w-full transition-transform duration-500 group-hover:scale-[1.025]"
            />
          </span>
          {img.caption && (
            <span class="flex items-baseline justify-between gap-3 px-3 py-2 font-mono text-[11px] text-silver">
              <span>{img.caption}</span>
              <span class="text-silver/40">{String(i + 1).padStart(2, '0')}</span>
            </span>
          )}
        </button>
      ))
    }
  </div>

  <dialog class="gallery-lightbox" data-gallery-lightbox aria-label={title ? `${title} — image viewer` : 'Image viewer'}>
    <div class="lb-surface" data-lb-backdrop>
      <div class="lb-topbar">
        <span class="font-mono text-[11px] tracking-[0.18em] text-silver" data-lb-counter>1 / 1</span>
        <button type="button" class="lb-btn" data-lb-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>

      <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Previous image">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
      </button>

      <figure class="lb-figure" data-lb-backdrop>
        <img class="lb-img" data-lb-img alt="" />
        <figcaption class="lb-caption" data-lb-caption></figcaption>
      </figure>

      <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Next image">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
      </button>
    </div>
  </dialog>
</div>

<style>
  .gallery-lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }
  .gallery-lightbox::backdrop {
    background: rgb(10 10 12 / 0.94);
    backdrop-filter: blur(8px);
  }
  .lb-surface {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: 4rem 1rem 2rem;
  }
  .lb-topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
  }
  .lb-btn, .lb-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    background: rgb(18 18 22 / 0.8);
    color: #fff;
    transition: border-color 150ms, color 150ms, box-shadow 150ms;
  }
  .lb-btn:hover, .lb-nav:hover { border-color: var(--color-neon); color: var(--color-neon); box-shadow: var(--shadow-neon-sm); }
  .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); }
  .lb-prev { left: 1rem; }
  .lb-next { right: 1rem; }
  .lb-figure { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; max-width: min(92vw, 1400px); }
  .lb-img {
    max-width: 100%;
    max-height: calc(100vh - 9rem);
    object-fit: contain;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    box-shadow: 0 0 60px rgb(0 255 255 / 0.08);
  }
  .lb-caption { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--color-silver); text-align: center; }
  @media (max-width: 640px) {
    .lb-nav { top: auto; bottom: 1rem; transform: none; }
  }
</style>

<script>
  function initGallery(root: HTMLElement) {
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-gallery-item]'));
    const dialog = root.querySelector<HTMLDialogElement>('[data-gallery-lightbox]');
    if (!dialog || items.length === 0) return;

    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
    let index = 0;

    // Reveal the placeholder for any image that has not been mounted yet.
    items.forEach((item) => {
      const el = item.querySelector('img');
      el?.addEventListener('error', () => item.classList.add('is-missing'), { once: true });
      if (el?.complete && el.naturalWidth === 0 && el.src) item.classList.add('is-missing');
    });

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const item = items[index];
      img.src = item.dataset.src ?? '';
      img.alt = item.dataset.alt ?? '';
      caption.textContent = item.dataset.caption || item.dataset.alt || '';
      counter.textContent = `${index + 1} / ${items.length}`;
    };

    items.forEach((item, i) =>
      item.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );

    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog || target.hasAttribute('data-lb-backdrop')) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });

    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      items[index]?.focus();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>
