---
import { SOCIALS } from '../lib/content';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-charcoal/60">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      

      <nav aria-label="Social links">
        <p class="mono-label text-silver/60">Elsewhere</p>
        <ul class="mt-3 grid grid-cols-2 gap-x-8 gap-y-3 sm:grid-cols-3 md:grid-cols-5 sm:gap-x-6">
          {
            SOCIALS.map(({ label, handle, href }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="me noopener noreferrer"
                  class="group block font-mono text-xs"
                >
                  <span class="block text-white transition-colors group-hover:text-neon">
                    {label}
                    <span class="ml-1 inline-block text-neon opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">↗</span>
                  </span>
                  <span class="mt-0.5 block text-[11px] text-silver/60">{handle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-line pt-6 font-mono text-[11px] text-silver/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Dashiell Badcock. All rights reserved.</p>
      <p>
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-neon align-middle shadow-neon-sm" aria-hidden="true"></span>
        <span class="ml-2 align-middle">Built with Astro · Served from the edge</span>
      </p>
    </div>
  </div>
</footer>
