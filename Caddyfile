{
	admin off
	# TLS is expected to be terminated by an upstream proxy. Remove this line and
	# replace `:80` with your domain to let Caddy manage certificates itself.
	auto_https off
}

:80 {
	root * /usr/share/caddy
	encode zstd gzip

	# ------------------------------------------------------------------
	# /media/* → external mount at /usr/share/caddy/media
	# handle_path strips the /media prefix before hitting the file server,
	# so /media/art/x.mp4 resolves to /usr/share/caddy/media/art/x.mp4.
	# Range requests (video scrubbing) are supported by file_server.
	# ------------------------------------------------------------------
	handle_path /media/* {
		root * /usr/share/caddy/media
		header Cache-Control "public, max-age=604800"
		header Accept-Ranges bytes
		file_server
	}

	# Hashed Astro assets are immutable.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Static site (Astro `directory` build format → /art/ → /art/index.html)
	handle {
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}
